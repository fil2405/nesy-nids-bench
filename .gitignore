# data and outputs: never committed
data/raw/*
data/interim/*
!data/**/.gitkeep
results/*
!results/.gitkeep
# python
__pycache__/
*.pyc
.venv/
*.egg-info/
# notebooks and editors
.ipynb_checkpoints/
.vscode/
.idea/
*.log
# LaTeX build files (the PDF is rebuilt from tesi/)
tesi/**/*.aux
tesi/**/*.bbl
tesi/**/*.blg
tesi/**/*.out
tesi/**/*.toc
tesi/**/*.lof
tesi/**/*.lot
tesi/**/*.fls
tesi/**/*.fdb_latexmk
tesi/**/*.synctex.gz
tesi/main.pdf
# Windows download marks
*:Zone.Identifier

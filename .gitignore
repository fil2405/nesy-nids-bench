# data and outputs: never committed
data/raw/*
data/interim/*
!data/**/.gitkeep
results/*
!results/.gitkeep
# python
__pycache__/
*.pyc
.venv/
*.egg-info/
# notebooks and editors
.ipynb_checkpoints/
.vscode/
.idea/
*.log
# LaTeX build files (the PDF is rebuilt from thesis/)
thesis/**/*.aux
thesis/**/*.bbl
thesis/**/*.blg
thesis/**/*.out
thesis/**/*.toc
thesis/**/*.lof
thesis/**/*.lot
thesis/**/*.fls
thesis/**/*.fdb_latexmk
thesis/**/*.synctex.gz
thesis/main.pdf
# Windows download marks
*:Zone.Identifier
